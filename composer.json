{
    "name": "bulletdigitalsolutions/livewire-charts",
    "description": "Livewire Charts, forked for Laravel 12 and 13 support and a Livewire 3 serialisation fix",
    "keywords": [
        "asantibanez",
        "livewire-charts"
    ],
    "homepage": "https://github.com/BulletDigitalSolutions/livewire-charts",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrés Santibáñez",
            "email": "santibanez.andres@gmail.com",
            "role": "Developer"
        }
    ],
    "replace": {
        "asantibanez/livewire-charts": "*"
    },
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asantibanez\\LivewireCharts\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asantibanez\\LivewireCharts\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asantibanez\\LivewireCharts\\LivewireChartsServiceProvider"
            ],
            "aliases": {
                "LivewireCharts": "Asantibanez\\LivewireCharts\\LivewireChartsFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
